# ==============================================================================
# NeuralSearch – Enterprise AI Knowledge & Research Assistant Configuration
# ==============================================================================

# Database Configuration
# Local development default: sqlite:///./data/neuralsearch.db
# PostgreSQL Docker default: postgresql://neuralsearch_user:neuralsearch_password@localhost:5432/neuralsearch_db
DATABASE_URL=sqlite:///./data/neuralsearch.db

# LLM Provider Configuration
# Options: "mock" (offline/zero-cost), "openai", "gemini", "anthropic", "ollama"
DEFAULT_LLM_PROVIDER=mock

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude API Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Sentence Transformers & Reranker Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Ingestion & Chunking Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_CHUNKING_STRATEGY=recursive

# Hybrid Retrieval Settings
DEFAULT_TOP_K=6
DEFAULT_RERANK_TOP_K=4
HYBRID_ALPHA=0.5
